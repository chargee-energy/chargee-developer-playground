# Ampere API origin (NO /api/v2 suffix — the generated client paths already include it).
VITE_AMPERE_API_URL=https://ampere.chargee.io

# Swagger UI base used for the "View in API docs" deep links.
VITE_AMPERE_DOCS_URL=https://ampere.chargee.io/api/v2

# Order fulfillment API (optional, separate credentials).
VITE_ORDER_API_URL=https://order-api.chargee.io
VITE_ORDER_DOCS_URL=https://order-api.chargee.io/api/v1
